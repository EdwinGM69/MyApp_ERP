generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Empresa {
  id                       Int                             @id @default(autoincrement())
  nombre                   String
  nif                      String                          @unique
  industria                String?
  representante            String?
  logo_url                 String?
  email                    String?
  telefono                 String?
  direccion_fiscal         String?
  sitio_web                String?
  moneda_default           String                          @default("USD")
  zona_horaria             String                          @default("UTC")
  activo                   Boolean                         @default(true)
  created_at               DateTime                        @default(now())
  updated_at               DateTime                        @updatedAt
  created_by               Int?
  updated_by               Int?
  almacenes                Almacen[]
  bancos                   Banco[]
  cajas                    Caja[]
  clientes                 Cliente[]
  cupones                  Cupon[]
  documentosIdentificacion DocumentoIdentificacion[]
  esquemaMateriales        EsquemaMaterial[]
  EsquemaMaterialLog       EsquemaMaterialLog[]
  esquemaReglas            EsquemaRegla[]
  esquemaReglaLogs         EsquemaReglaLog[]
  esquemasValoracion       EsquemaValoracion[]
  esquemaValoracionLog     EsquemaValoracionLog[]
  impuestos                Impuesto[]
  industrias               Industria[]
  marcas                   Marca[]
  materiales               Material[]
  materialCategorias       MaterialCategoria[]
  materialCostos           MaterialCosto[]
  materialTipos            MaterialTipo[]
  monedas                  Moneda[]
  movimientos              MovimientoAlmacen[]
  paises                   Pais[]
  promociones              Promocion[]
  proveedores              Proveedor[]
  sucursales               Sucursal[]
  tiposOperacion           TipoOperacion[]
  unidadesMedida           UnidadMedida[]
  usuarios                 Usuario[]
  ventas                   Venta[]
  ubicaciones              Ubicacion[]
  almacenUbicaciones       AlmacenUbicacion[]
  lotes                    Lote[]
  estados_stock            EstadoStock[]
  stock_materiales         StockMaterial[]
  stock_historial          StockMaterialHistorial[]
  distribuciones           MovimientoDetalleDistribucion[]
  tipos_cambio_fuente      TipoCambioFuente[]
  tipos_cambio             TipoCambio[]
  modulos                  EmpresaModulo[]
  mediosPago               MedioPago[]
  conceptos_caja           ConceptoCaja[]
  tipos_condicion          TipoCondicion[]
  condiciones              Condicion[]
  esquemas_calculo         EsquemaCalculo[]
  clases_pedido            ClasePedido[]
  monedas_denominacion     MonedaDenominacion[]
  transacciones_caja       TransaccionCaja[]
  flujos_documentos        FlujoDocumentos[]
}

model Rol {
  id                   Int          @id @default(autoincrement())
  nombre               String       @unique
  descripcion          String?
  usuarios             Usuario[]
  usuarios_adicionales UsuarioRol[]
}

model Usuario {
  id                             Int                       @id @default(autoincrement())
  empresa_id                     Int
  rol_id                         Int
  nombre                         String
  email                          String
  password_hash                  String
  avatar_url                     String?
  telefono                       String?
  posicion                       String?
  is_superadmin                  Boolean                   @default(false)
  two_factor_enabled             Boolean                   @default(false)
  preferencias                   Json?
  activo                         Boolean                   @default(true)
  recordar                       Boolean                   @default(false)
  reset_token                    String?
  reset_expiry                   DateTime?
  created_at                     DateTime                  @default(now())
  updated_at                     DateTime                  @updatedAt
  created_by                     Int?
  updated_by                     Int?
  almacenes_creados              Almacen[]                 @relation("AlmacenCreador")
  almacenes_modificados          Almacen[]                 @relation("AlmacenModificador")
  bancos_creados                 Banco[]                   @relation("BancoCreador")
  bancos_modificados             Banco[]                   @relation("BancoModificador")
  documentos_creados             DocumentoIdentificacion[] @relation("DocumentoCreador")
  documentos_modificados         DocumentoIdentificacion[] @relation("DocumentoModificador")
  esquema_materiales_creados     EsquemaMaterial[]         @relation("EsquemaMaterialCreador")
  EsquemaMaterialLog             EsquemaMaterialLog[]
  reglas_creadas                 EsquemaRegla[]            @relation("ReglaCreador")
  reglas_modificadas             EsquemaRegla[]            @relation("ReglaModificador")
  regla_logs_creados             EsquemaReglaLog[]         @relation("ReglaLogCreador")
  esquemas_creados               EsquemaValoracion[]       @relation("EsquemaCreador")
  esquemas_modificados           EsquemaValoracion[]       @relation("EsquemaModificador")
  esquema_logs_creados           EsquemaValoracionLog[]    @relation("EsquemaLogCreador")
  industrias_creadas             Industria[]               @relation("IndustriaCreador")
  industrias_modificadas         Industria[]               @relation("IndustriaModificador")
  marcas_creadas                 Marca[]                   @relation("MarcaCreador")
  marcas_modificadas             Marca[]                   @relation("MarcaModificador")
  categorias_creadas             MaterialCategoria[]       @relation("CategoriaCreador")
  categorias_modificadas         MaterialCategoria[]       @relation("CategoriaModificador")
  componentes_creados            MaterialComponente[]      @relation("ComponenteCreador")
  componentes_modificados        MaterialComponente[]      @relation("ComponenteModificador")
  material_costos_aprobados      MaterialCosto[]           @relation("MaterialCostoAprobador")
  material_costos_creados        MaterialCosto[]           @relation("MaterialCostoCreador")
  presentaciones_creadas         MaterialPresentacion[]    @relation("PresentacionCreador")
  presentaciones_modificadas     MaterialPresentacion[]    @relation("PresentacionModificador")
  sustitutos_creados             MaterialSustituto[]       @relation("SustitutoCreador")
  sustitutos_modificados         MaterialSustituto[]       @relation("SustitutoModificador")
  tipos_creados                  MaterialTipo[]            @relation("TipoCreador")
  tipos_modificados              MaterialTipo[]            @relation("TipoModificador")
  monedas_creadas                Moneda[]                  @relation("MonedaCreador")
  monedas_modificadas            Moneda[]                  @relation("MonedaModificador")
  paises_creados                 Pais[]                    @relation("PaisCreador")
  paises_modificados             Pais[]                    @relation("PaisModificador")
  proveedores_creados            Proveedor[]               @relation("ProveedorCreador")
  proveedores_modificados        Proveedor[]               @relation("ProveedorModificador")
  sucursales_creadas             Sucursal[]                @relation("SucursalCreador")
  sucursales_modificadas         Sucursal[]                @relation("SucursalModificador")
  sucursal_almacen_creados       SucursalAlmacen[]         @relation("SucursalAlmacenCreador")
  sucursal_almacen_modificados   SucursalAlmacen[]         @relation("SucursalAlmacenModificador")
  sucursal_caja_creados          SucursalCaja[]            @relation("SucursalCajaCreador")
  sucursal_caja_modificados      SucursalCaja[]            @relation("SucursalCajaModificador")
  tipos_cuenta_banco_creados     TipoCuentaBanco[]         @relation("TipoCuentaBancoCreador")
  tipos_cuenta_banco_modificados TipoCuentaBanco[]         @relation("TipoCuentaBancoModificador")
  tipos_operacion_creados        TipoOperacion[]           @relation("TipoOperacionCreador")
  tipos_operacion_modificados    TipoOperacion[]           @relation("TipoOperacionModificador")
  medios_pago_creados            MedioPago[]               @relation("MedioPagoCreador")
  medios_pago_modificados        MedioPago[]               @relation("MedioPagoModificador")
  conceptos_caja_creados         ConceptoCaja[]            @relation("ConceptoCajaCreador")
  conceptos_caja_modificados     ConceptoCaja[]            @relation("ConceptoCajaModificador")
  unidades_creadas               UnidadMedida[]            @relation("UnidadCreador")
  unidades_modificadas           UnidadMedida[]            @relation("UnidadModificador")
  ubicaciones_creadas            Ubicacion[]               @relation("UbicacionCreador")
  ubicaciones_modificadas        Ubicacion[]               @relation("UbicacionModificador")
  almacen_ubicacion_creado       AlmacenUbicacion[]        @relation("AlmacenUbicacionCreador")
  almacen_ubicacion_modificado   AlmacenUbicacion[]        @relation("AlmacenUbicacionModificador")
  tipo_cambio_fuente_creados     TipoCambioFuente[]        @relation("TipoCambioFuenteCreador")
  tipo_cambio_fuente_modificados TipoCambioFuente[]        @relation("TipoCambioFuenteModificador")
  tipo_cambio_creados            TipoCambio[]              @relation("TipoCambioCreador")
  tipo_cambio_modificados        TipoCambio[]              @relation("TipoCambioModificador")
  empresa_modulos_creados        EmpresaModulo[]           @relation("EmpresaModuloCreador")
  empresa                        Empresa                   @relation(fields: [empresa_id], references: [id])
  rol                            Rol                       @relation(fields: [rol_id], references: [id])
  roles_adicionales              UsuarioRol[]
  tipos_condicion_creados        TipoCondicion[]           @relation("TipoCondicionCreador")
  tipos_condicion_modificados    TipoCondicion[]           @relation("TipoCondicionModificador")
  condiciones_creadas            Condicion[]               @relation("CondicionCreador")
  condiciones_modificadas        Condicion[]               @relation("CondicionModificador")
  esquemas_calculo_creados       EsquemaCalculo[]          @relation("EsquemaCalculoCreador")
  esquemas_calculo_modificados   EsquemaCalculo[]          @relation("EsquemaCalculoModificador")
  Variables_creadas              EsquemaCalculoVariables[] @relation("EsquemaCalculoVarCreador")
  Variables_modificadas          EsquemaCalculoVariables[] @relation("EsquemaCalculoVarModificador")
  pasos_creados                  EsquemaCalculoPasos[]     @relation("EsquemaCalculoPasoCreador")
  pasos_modificados              EsquemaCalculoPasos[]     @relation("EsquemaCalculoPasoModificador")
  clases_pedido_creados          ClasePedido[]             @relation("ClasePedidoCreador")
  clases_pedido_modificados      ClasePedido[]             @relation("ClasePedidoModificador")
  caja_gestion                   CajaGestion[]             @relation("CajaApertura")
  caja_arqueos                   CajaArqueo[]              @relation("UsuarioArqueo")
  transacciones_creadas          TransaccionCaja[]         @relation("TransaccionCreador")
  transacciones_modificadas      TransaccionCaja[]         @relation("TransaccionModificador")
  flujos_documentos_creados      FlujoDocumentos[]         @relation("FlujoDocumentosCreador")

  @@unique([empresa_id, email])
}

model UsuarioRol {
  id         Int      @id @default(autoincrement())
  usuario_id Int
  rol_id     Int
  created_at DateTime @default(now())
  rol        Rol      @relation(fields: [rol_id], references: [id], onDelete: Cascade)
  usuario    Usuario  @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@unique([usuario_id, rol_id])
}

model Impuesto {
  id          Int        @id @default(autoincrement())
  empresa_id  Int
  codigo      String
  descripcion String
  porcentaje  Decimal    @db.Decimal(5, 2)
  tipo        String
  activo      Boolean    @default(true)
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt
  created_by  Int?
  updated_by  Int?
  empresa     Empresa    @relation(fields: [empresa_id], references: [id])
  materiales  Material[]

  @@unique([empresa_id, codigo])
}

model Material {
  id                        Int                        @id @default(autoincrement())
  empresa_id                Int
  codigo                    String
  descripcion               String
  unidad_medida             String?
  precio_costo              Decimal                    @default(0) @db.Decimal(12, 2)
  precio_venta              Decimal                    @default(0) @db.Decimal(12, 2)
  stock_actual              Decimal                    @default(0) @db.Decimal(12, 3)
  stock_minimo              Decimal                    @default(0) @db.Decimal(12, 3)
  imagen_url                String?
  impuesto_id               Int?
  activo                    Boolean                    @default(true)
  created_at                DateTime                   @default(now())
  updated_at                DateTime                   @updatedAt
  created_by                Int?
  updated_by                Int?
  codigo_mascara            String?
  codigo_barras             String?
  nivel_rotacion            String?
  stock_maximo              Decimal?                   @db.Decimal(12, 3)
  perecible                 Boolean                    @default(false)
  compuesto                 Boolean                    @default(false)
  fecha_vencimiento         DateTime?
  marca_id                  Int?
  moneda_precio_compra      String                     @default("USD")
  moneda_costo_promedio     String                     @default("USD")
  costo_promedio            Decimal?                   @db.Decimal(12, 2)
  proveedor_id              Int?
  categoria_id              Int?
  tipo_id                   Int?
  unidad_medida_id          Int?
  moneda_costo_promedio_id  Int?
  moneda_precio_compra_id   Int?
  esquema_id                Int?
  stock_lote                Boolean?                   @default(false)
  ubicacion_default_id      Int?
  cupon_detalles            CuponDetalle[]
  esquemas                  EsquemaMaterial[]
  EsquemaMaterialLog        EsquemaMaterialLog[]
  categoria_rel             MaterialCategoria?         @relation(fields: [categoria_id], references: [id])
  empresa                   Empresa                    @relation(fields: [empresa_id], references: [id])
  EsquemaValoracion         EsquemaValoracion?         @relation(fields: [esquema_id], references: [id])
  impuesto                  Impuesto?                  @relation(fields: [impuesto_id], references: [id])
  marca                     Marca?                     @relation(fields: [marca_id], references: [id])
  moneda_costo_promedio_rel Moneda?                    @relation("MonedaCostoPromedio", fields: [moneda_costo_promedio_id], references: [id])
  moneda_precio_compra_rel  Moneda?                    @relation("MonedaPrecioCompra", fields: [moneda_precio_compra_id], references: [id])
  proveedor                 Proveedor?                 @relation(fields: [proveedor_id], references: [id])
  tipo_rel                  MaterialTipo?              @relation(fields: [tipo_id], references: [id])
  unidad_medida_rel         UnidadMedida?              @relation(fields: [unidad_medida_id], references: [id])
  usado_en                  MaterialComponente[]       @relation("MaterialHijo")
  componentes               MaterialComponente[]       @relation("MaterialPadre")
  costos                    MaterialCosto[]
  presentaciones            MaterialPresentacion[]
  sustitutos                MaterialSustituto[]        @relation("MaterialPrincipal")
  es_sustituto_de           MaterialSustituto[]        @relation("MaterialSustituto")
  mov_detalles              MovimientoAlmacenDetalle[]
  promo_detalles            PromocionDetalle[]
  venta_detalles            VentaDetalle[]
  lotes                     Lote[]
  stock_materiales          StockMaterial[]
  stock_historial           StockMaterialHistorial[]
  ubicacion_default         Ubicacion?                 @relation(fields: [ubicacion_default_id], references: [id])
  condiciones               Condicion[]

  @@unique([empresa_id, codigo])
  @@index([esquema_id])
}

model MaterialSustituto {
  id                  Int      @id @default(autoincrement())
  material_id         Int
  sustituto_id        Int
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
  created_by          Int?
  updated_by          Int?
  usuario_creador     Usuario? @relation("SustitutoCreador", fields: [created_by], references: [id])
  material            Material @relation("MaterialPrincipal", fields: [material_id], references: [id])
  sustituto           Material @relation("MaterialSustituto", fields: [sustituto_id], references: [id])
  usuario_modificador Usuario? @relation("SustitutoModificador", fields: [updated_by], references: [id])

  @@unique([material_id, sustituto_id])
}

model MaterialPresentacion {
  id                  Int      @id @default(autoincrement())
  material_id         Int
  codigo              String
  descripcion         String
  unidad              String
  activo              Boolean  @default(true)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
  created_by          Int?
  updated_by          Int?
  usuario_creador     Usuario? @relation("PresentacionCreador", fields: [created_by], references: [id])
  material            Material @relation(fields: [material_id], references: [id], onDelete: Cascade)
  usuario_modificador Usuario? @relation("PresentacionModificador", fields: [updated_by], references: [id])

  @@unique([material_id, codigo])
}

model MaterialComponente {
  id                  Int      @id @default(autoincrement())
  material_id         Int
  componente_id       Int
  cantidad            Decimal  @db.Decimal(12, 4)
  unidad_medida_id    Int
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
  created_by          Int?
  updated_by          Int?
  componente          Material @relation("MaterialHijo", fields: [componente_id], references: [id])
  usuario_creador     Usuario? @relation("ComponenteCreador", fields: [created_by], references: [id])
  material            Material @relation("MaterialPadre", fields: [material_id], references: [id], onDelete: Cascade)
  usuario_modificador Usuario? @relation("ComponenteModificador", fields: [updated_by], references: [id])
  unidad_medida       UnidadMedida @relation(fields: [unidad_medida_id], references: [id])

  @@unique([material_id, componente_id])
}

model MaterialCosto {
  id                Int               @id @default(autoincrement())
  empresa_id        Int
  material_id       Int
  moneda_id         Int
  costo             Decimal           @db.Decimal(12, 2)
  fecha_desde       DateTime
  fecha_hasta       DateTime?
  created_at        DateTime          @default(now())
  created_by        Int?
  aproved_at        DateTime?
  aproved_by        Int?
  esquema_id        Int
  usuario_aprobador Usuario?          @relation("MaterialCostoAprobador", fields: [aproved_by], references: [id])
  usuario_creador   Usuario?          @relation("MaterialCostoCreador", fields: [created_by], references: [id])
  empresa           Empresa           @relation(fields: [empresa_id], references: [id])
  esquema           EsquemaValoracion @relation(fields: [esquema_id], references: [id])
  material          Material          @relation(fields: [material_id], references: [id], onDelete: Cascade)
  moneda            Moneda            @relation(fields: [moneda_id], references: [id])

  @@index([empresa_id, material_id])
  @@index([fecha_desde, fecha_hasta])
}

model EsquemaValoracion {
  id                                                                           Int                        @id @default(autoincrement())
  empresa_id                                                                   Int
  codigo                                                                       String
  nombre                                                                       String
  descripcion                                                                  String?
  metodo_costo                                                                 String?
  decimal_precision                                                            Int                        @default(2)
  requiere_aprobacion                                                          Boolean                    @default(false)
  activo                                                                       Boolean                    @default(true)
  created_at                                                                   DateTime                   @default(now())
  updated_at                                                                   DateTime                   @updatedAt
  created_by                                                                   Int?
  updated_by                                                                   Int?
  materiales                                                                   EsquemaMaterial[]
  EsquemaMaterialLog_EsquemaMaterialLog_esquema_anterior_idToEsquemaValoracion EsquemaMaterialLog[]       @relation("EsquemaMaterialLog_esquema_anterior_idToEsquemaValoracion")
  EsquemaMaterialLog_EsquemaMaterialLog_esquema_nuevo_idToEsquemaValoracion    EsquemaMaterialLog[]       @relation("EsquemaMaterialLog_esquema_nuevo_idToEsquemaValoracion")
  reglas                                                                       EsquemaRegla[]
  usuario_creador                                                              Usuario?                   @relation("EsquemaCreador", fields: [created_by], references: [id])
  empresa                                                                      Empresa                    @relation(fields: [empresa_id], references: [id])
  usuario_modificador                                                          Usuario?                   @relation("EsquemaModificador", fields: [updated_by], references: [id])
  logs                                                                         EsquemaValoracionLog[]
  Material                                                                     Material[]
  material_costos                                                              MaterialCosto[]
  movimiento_detalles                                                          MovimientoAlmacenDetalle[] @relation("EsquemaMovimientos")

  @@unique([empresa_id, codigo])
}

model EsquemaRegla {
  id                  Int               @id @default(autoincrement())
  empresa_id          Int
  esquema_id          Int
  tipo_regla          String
  umbral_valor        String?
  accion              String?
  orden               Int               @default(0)
  activo              Boolean           @default(true)
  created_at          DateTime          @default(now())
  updated_at          DateTime          @updatedAt
  created_by          Int?
  updated_by          Int?
  usuario_creador     Usuario?          @relation("ReglaCreador", fields: [created_by], references: [id])
  empresa             Empresa           @relation(fields: [empresa_id], references: [id])
  esquema             EsquemaValoracion @relation(fields: [esquema_id], references: [id], onDelete: Cascade)
  usuario_modificador Usuario?          @relation("ReglaModificador", fields: [updated_by], references: [id])
  logs                EsquemaReglaLog[]
}

model EsquemaValoracionLog {
  id               Int               @id @default(autoincrement())
  empresa_id       Int
  esquema_id       Int
  campo_modificado String?
  valor_anterior   String?
  valor_nuevo      String?
  motivo           String?
  created_at       DateTime          @default(now())
  created_by       Int?
  usuario_creador  Usuario?          @relation("EsquemaLogCreador", fields: [created_by], references: [id])
  empresa          Empresa           @relation(fields: [empresa_id], references: [id])
  esquema          EsquemaValoracion @relation(fields: [esquema_id], references: [id], onDelete: Cascade)
}

model EsquemaReglaLog {
  id              Int          @id @default(autoincrement())
  empresa_id      Int
  regla_id        Int
  accion          String
  snapshot_log    Json
  created_at      DateTime     @default(now())
  created_by      Int?
  usuario_creador Usuario?     @relation("ReglaLogCreador", fields: [created_by], references: [id])
  empresa         Empresa      @relation(fields: [empresa_id], references: [id])
  regla           EsquemaRegla @relation(fields: [regla_id], references: [id], onDelete: Cascade)
}

model EsquemaMaterial {
  id              Int               @id @default(autoincrement())
  empresa_id      Int
  esquema_id      Int
  material_id     Int
  activo          Int               @default(1)
  created_at      DateTime          @default(now())
  created_by      Int?
  usuario_creador Usuario?          @relation("EsquemaMaterialCreador", fields: [created_by], references: [id])
  empresa         Empresa           @relation(fields: [empresa_id], references: [id])
  esquema         EsquemaValoracion @relation(fields: [esquema_id], references: [id], onDelete: Cascade)
  material        Material          @relation(fields: [material_id], references: [id], onDelete: Cascade)

  @@unique([esquema_id, material_id])
}

model Cliente {
  id          Int                 @id @default(autoincrement())
  empresa_id  Int
  codigo      String
  tipo        String              @default("natural")
  nombre      String
  nombres_completos String?
  apellidos_completos String?
  nif         String?
  email       String?
  telefono    String?
  direccion   String?
  contacto    String?
  activo      Boolean             @default(true)
  created_at  DateTime            @default(now())
  updated_at  DateTime            @updatedAt
  created_by  Int?
  updated_by  Int?
  empresa     Empresa             @relation(fields: [empresa_id], references: [id])
  movimientos MovimientoAlmacen[]
  ventas      Venta[]
  transacciones TransaccionCaja[]

  @@unique([empresa_id, codigo])
}

model Proveedor {
  id                  Int                      @id @default(autoincrement())
  empresa_id          Int
  codigo              String
  tipo                String                   @default("empresa")
  tipo_proveedor      String                   @default("Nacional")
  nombre              String
  categoria           String?
  tipo_nif            String?
  nif                 String?
  email               String?
  telefono            String?
  direccion           String?
  banco               String?
  tipo_cuenta         String?
  banco_cuenta        String?
  banco_swift         String?
  banco_titular       String?
  activo              Boolean                  @default(true)
  created_at          DateTime                 @default(now())
  updated_at          DateTime                 @updatedAt
  created_by          Int?
  updated_by          Int?
  industria_id        Int?
  tipo_nif_id         Int?
  banco_id            Int?
  tipo_cuenta_id      Int?
  materiales          Material[]
  movimientos         MovimientoAlmacen[]
  banco_entidad       Banco?                   @relation(fields: [banco_id], references: [id])
  usuario_creador     Usuario?                 @relation("ProveedorCreador", fields: [created_by], references: [id])
  empresa             Empresa                  @relation(fields: [empresa_id], references: [id])
  industria           Industria?               @relation(fields: [industria_id], references: [id])
